            >
              <EcoIcon class="w-12 h-12 text-on-primary" aria-hidden="true" />
            </div>
          </div>
          <div class="pt-12 space-y-4">
            <div class="h-48 bg-secondary-container rounded-xl overflow-hidden">
              <Image
                alt="Healthy fats"
                width={800}
                height={480}
                class="w-full h-full object-cover"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBFHPz9X2Nf1c01cjJ6L3xBLfaYw7qEjMDZW9gdXLFnY2n6Nffpnd-plAKC-RcqMaYqXSQLR6QvyGA39xBy50rE-pEzKBlt9PsCr3yNu0oOgnXmkpfh3_z-uB8LY70k9NIQuXuIv_ZMGJsmKGXAsPf18FYC7ibjuKuhdvP_IjEAGc-xdgM_KHRZot00lsGVxsWwE4AFBhx7jpVCktKyjmMBD-eIYZu3pROMuQkvCNbWI3a9ZCrSzDdATp9Y06r72Nl61SnFOSKxpvzm"
