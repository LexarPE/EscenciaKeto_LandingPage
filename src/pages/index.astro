              </div>
              <h3 class="font-headline-sm text-headline-sm text-on-surface">
                Galletas de Almendra
              </h3>
              <p class="font-body-md text-body-md text-secondary">
                Crujientes por fuera y tiernas por dentro, el clásico snack keto
                reinventado.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- About Section -->
    <section
      class="max-w-container-max mx-auto px-gutter py-section-gap flex flex-col md:flex-row gap-20 items-center"
    >
      <div class="flex-1 order-2 md:order-1">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="h-64 bg-surface-container rounded-xl overflow-hidden">
