            <div class="relative overflow-hidden rounded-xl mb-6">
              <Image
                alt="Galletas de Almendra"
                width={600}
                height={800}
                class="w-full aspect-3/4 object-cover transition-transform duration-700 group-hover:scale-105"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBckkY5hPMFc2mRXH2uon_4rIxTzXVQvlaSVwaXF9BzBchI8FtbpRngjn_uXNnSE_AMqyuniZ7RsWT1clKJZn3kNdM__RyCddCxe0t6M-cL8KWrjib8vji3JOGdkgt2HD1XMlcwZWhZLuTXW8GJJdJbftP5xg1WAEjLY9be5EoucWsuGRK9cB5Cyp5HbD8_mdmqsiER9uVsxuJ5NP4zUpNdjnP1LJiUraV_rpEMGhnRe1ID7If-brr619UDkQOG4WmFlyLCAp3hKJBp"
