---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { Image } from "astro:assets";
import EcoIcon from "../assets/eco.svg";
---

<Layout>
  <!-- TopNavBar -->
  <header
    class="bg-background/90 dark:bg-background/90 backdrop-blur-md docked full-width top-0 sticky z-50"
  >
    <nav
      class="max-w-container-max mx-auto px-gutter flex justify-between items-center h-20"
    >
      <span
        class="font-display-lg text-headline-sm text-primary dark:text-primary-fixed tracking-tight"
        >Esencia Keto</span
      >

      <a
        href="https://wa.me/51953357678?text=Estoy%20interesado%20en%20obtener%20el%20libro%20digital%20de%20postres%20keto"
        target="_blank"
        class="bg-primary text-on-primary px-6 py-2.5 rounded-lg font-label-sm text-label-sm transition-all active:opacity-80 cursor-pointer"
      >
        Obtener el Libro
      </a>
    </nav>
  </header>
  <main>
    <!-- Hero Section -->
    <section
      class="max-w-container-max mx-auto px-gutter py-section-gap-mobile md:py-section-gap flex flex-col md:flex-row items-center gap-16 overflow-hidden"
    >
      <div class="flex-1 space-y-8 z-10">
        <h1
          class="font-display-lg text-display-lg-mobile md:text-display-lg text-primary"
        >
          Postres Keto: Solo 3 ingredientes, cero culpas.
        </h1>
        <p class="font-body-lg text-body-lg text-secondary max-w-lg">
          Descubre la simplicidad de la repostería low-carb. Recetas
          minimalistas diseñadas para satisfacer tus antojos sin comprometer tu
          estilo de vida saludable.
        </p>
        <div class="flex gap-4 pt-4">
          <a
            href="https://wa.me/51953357678?text=Estoy%20interesado%20en%20obtener%20el%20libro%20digital%20de%20postres%20keto"
            target="_blank"
            class="bg-primary text-on-primary px-8 py-4 rounded-lg font-label-sm text-label-sm uppercase tracking-widest hover:bg-primary-container transition-colors shadow-lg cursor-pointer"
          >
            Comprar ahora
          </a>
        </div>
      </div>
      <div class="flex-1 w-full md:w-auto relative">
        <div
          class="absolute -top-12 -left-12 w-64 h-64 bg-primary-fixed/30 rounded-full blur-3xl -z-10"
        >
        </div>
        <Image
          alt="Keto chocolate dessert"
          width={800}
          height={1000}
          class="w-full aspect-4/5 object-cover rounded-xl soft-shadow"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCCTC4TtwpeoBxmClLR_94mTlDMgn9pXww0VnLiXC0iAn1lDf7eJOatLUpXACkuurBRIwTsHryRUvtZp7QG3-SbQ7kIK1xORD6AQ9qLT2MSS3f6sQ5FaoHU7pX9Yjb4Qfcscx0jPx3X296GNR8df8Ov3_ZDNaNaRrNliZYSP0ZuqksfWOgF79IWLZxGgV8Rl-lhF4UzJcxvf5C6u2XBABlppe5T0LUsKcO42sY1tikWN37pHUuCdJ707n7G7nrEurp6XejTv8LATU5Z"
          loading="eager"
        />
      </div>
    </section>
    <!-- Preview Grid -->
    <section
      class="bg-surface-container-low py-section-gap-mobile md:py-section-gap"
    >
      <div class="max-w-container-max mx-auto px-gutter">
        <div
          class="mb-16 flex flex-col md:flex-row justify-between items-end gap-4"
        >
          <div>
            <span
