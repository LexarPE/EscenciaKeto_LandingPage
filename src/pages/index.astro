            <div class="space-y-2">
              <div class="flex gap-2">
                <span
                  class="px-3 py-1 bg-tertiary/10 text-tertiary rounded-full font-label-sm text-[10px] uppercase tracking-widest"
                  >Cremoso</span
                >
              </div>
              <h3 class="font-headline-sm text-headline-sm text-on-surface">
                Mousse de Chocolate y Palta
              </h3>
              <p class="font-body-md text-body-md text-secondary">
                La combinación perfecta de grasas saludables y cacao puro para
                una textura irresistible.
              </p>
            </div>
          </div>
          <!-- Card 2 -->
          <div class="group cursor-pointer mt-8 md:mt-16">
            <div class="relative overflow-hidden rounded-xl mb-6">
              <Image
                alt="Bombones de Coco"
                width={600}
                height={800}
                class="w-full aspect-3/4 object-cover transition-transform duration-700 group-hover:scale-105"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCvYHzlrHTino9-aVOm522LZhPHxhY464gJlOy4EIhB3e3WXDaeu7UnHaRnmRwGHv9Gdm41vzDKCUza66y-cSOmotkI7WyGzmCTFiRDit8uir-t8hPRgt5EsSKcAMeMK3AbS97WZHiAIFSUUcJXv519q4ruscUR5SIQLgy6cxHwqu6MqgnOkp-Znj-5MhJ63xsWvw7vvyhwif1vRqymx_PzpZO-74GPc_ZQZbAu78kaQfHoBd76-3XGtqxseAGvi43dZOzhWhRXm1uz"
              />
            </div>
            <div class="space-y-2">
              <div class="flex gap-2">
                <span
